{
  "opencollection": "1.0.0",
  "info": {
    "name": "Screendoor Files API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://screendoor.dobt.co/api/form_renderer/file",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "response_field_id",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a file to be referenced by a File-type response field."
        }
      ]
    }
  ],
  "bundled": true
}